# dependencies & build output — installed/built fresh inside the image
node_modules
dist
coverage

# vcs / editor
.git
.gitignore
.vscode
.idea

# env — never bake these into an image; pass config at `docker run`/compose
# time instead (see docs/README-docker-k8s.md)
.env
.env.*

# tests — not needed to build or run the compiled app
test

# docs — irrelevant to the runtime image
*.md
docs
.claude

# misc
*.log
.nvmrc
