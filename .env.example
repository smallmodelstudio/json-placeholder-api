NODE_ENV=development
PORT=3000
UPSTREAM_BASE_URL=https://jsonplaceholder.typicode.com
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_MAX_RETRIES=2

CACHE_TTL_MS=30000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20

# Trust the X-Forwarded-For header from exactly one hop of reverse proxy in
# front of the app (see main.ts). Only turn this on where that's actually
# true — e.g. behind Traefik in k8s (k8s/base/configmap.yaml sets it there)
# — never when the app is reachable directly, as it is via docker-compose
# or `npm run start*`.
TRUST_PROXY=false

# Read directly by src/instrumentation.ts (loaded via --import, before Nest
# or ConfigService exist), not by src/config — these are the standard
# OTel env vars, not app-specific config. Unset, they default to
# http://localhost:4318, which is right for `npm run start:prod` on the
# host but not from inside a container (docker-compose.yml points this at
# the `otel` service instead; k8s/overlays/local patches the ConfigMap to
# point at its own in-cluster collector — see k8s/overlays/local/otel.yaml
# — while overlays/prod has no observability backend yet and keeps this
# default).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=json-placeholder-api
